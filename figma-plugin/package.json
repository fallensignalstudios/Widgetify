{
  "name": "widgetify-figma-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Figma side of Widgetify: exports a frame as a figmasync bundle (JSON + PNGs) for the Unreal FigmaSync importer.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "sample": "vitest run test/sample.test.ts --reporter=dot",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.141.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
